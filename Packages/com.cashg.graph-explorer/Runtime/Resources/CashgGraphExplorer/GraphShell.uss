/* Desktop shell tokens. Graph geometry, colors and backend semantics remain independent. */
#graph-explorer {
    --shell-background: rgb(8, 13, 21);
    --shell-panel: rgb(17, 26, 39);
    --shell-raised: rgb(25, 37, 55);
    --shell-line: rgb(44, 59, 80);
    --shell-text: rgb(240, 238, 232);
    --shell-muted: rgb(180, 191, 206);
    --shell-accent: rgb(255, 196, 119);
    color: var(--shell-text);
    font-size: 14px;
}

.header {
    height: 56px;
    padding: 8px 16px;
    background-color: var(--shell-panel);
    border-bottom-color: var(--shell-line);
    justify-content: flex-start;
}

.brand {
    margin-right: 12px;
    flex-shrink: 0;
}

.brand-mark {
    width: 30px;
    height: 30px;
    padding: 3px;
    font-size: 17px;
    -unity-text-align: middle-center;
    border-radius: 7px;
    color: var(--shell-accent);
    margin-right: 10px;
}

.app-title {
    font-size: 16px;
    white-space: nowrap;
    color: var(--shell-text);
}

Button {
    min-height: 34px;
    padding: 6px 10px;
    background-color: var(--shell-raised);
    border-color: var(--shell-line);
    border-radius: 6px;
    color: var(--shell-text);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.reduced-motion Button {
    transition-duration: 0s;
}

Button:hover {
    background-color: rgb(35, 50, 71);
    border-color: rgb(98, 121, 148);
}

Button:focus {
    border-color: var(--shell-accent);
}

Button.primary, Button.go {
    background-color: var(--shell-accent);
    border-color: var(--shell-accent);
    color: rgb(30, 22, 13);
}

Button.primary .icon-caption, Button.go .icon-caption {
    color: rgb(30, 22, 13);
}

.header-actions {
    margin-right: 4px;
}

Button.header-button {
    height: 36px;
    min-height: 36px;
    padding: 4px 9px;
    margin: 0 3px;
}

.shell-icon-only .header-button-label {
    display: none;
}

.shell-icon-only .header-icon {
    margin-right: 0;
}

.header-button-label {
    color: var(--shell-text);
    font-size: 13px;
}

.shell-search-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    max-width: 560px;
    margin-left: 12px;
    margin-right: 12px;
}

.shell-search-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    margin: 0;
}

.shell-search-row > .glyph {
    display: none;
}

.shell-search-row .ghost-wrap {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.shell-search-row .ghost-hint {
    position: absolute;
    left: 12px;
    right: 8px;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    color: var(--shell-muted);
    font-size: 14px;
}

.shell-search-row TextField {
    height: 36px;
    margin: 0;
    min-width: 0;
    flex-grow: 1;
}

.shell-search-row .unity-text-field__input {
    height: 36px;
    padding: 6px 12px;
    border-radius: 6px;
    background-color: rgb(10, 17, 27);
    border-color: var(--shell-line);
    color: var(--shell-text);
}

.shell-search-row .icon-button {
    margin-left: 5px;
}

.shell-header-progress {
    width: 128px;
    height: 6px;
    margin-right: 10px;
    flex-shrink: 0;
    align-self: center;
    display: none;
    overflow: hidden;
    border-radius: 3px;
    background-color: rgb(10, 17, 27);
    border-width: 1px;
    border-color: var(--shell-line);
}

.shell-header-progress.is-active {
    display: flex;
}

.shell-compact .shell-header-progress.is-active {
    display: none;
}

.shell-header-progress-fill {
    height: 100%;
    width: 0;
    background-color: rgb(139, 223, 188);
}

.shell-header-progress.is-indeterminate .shell-header-progress-fill {
    width: 35%;
}

.shell-source-status {
    font-size: 12px;
    color: rgb(139, 223, 188);
    margin-right: 8px;
    white-space: nowrap;
}

.shell-header-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
}

.shell-compact .brand .app-title, .shell-compact .shell-source-status {
    display: none;
}

.shell-compact .brand {
    margin-right: 3px;
}

.shell-compact .shell-search-host {
    margin-left: 6px;
    margin-right: 6px;
}

.shell-compact .header {
    padding-left: 8px;
    padding-right: 8px;
}

.shell-compact .timeline-panel {
    left: 72px;
}

.shell-compact .header .header-button .header-icon {
    display: none;
}

.shell-compact .header .shell-icon-only .header-icon {
    display: flex;
}

.shell-rail {
    position: absolute;
    left: 0;
    top: 56px;
    bottom: 0;
    width: 64px;
    padding: 12px 4px;
    background-color: var(--shell-panel);
    border-right-width: 1px;
    border-right-color: var(--shell-line);
}

Button.shell-rail-button {
    width: 54px;
    min-height: 58px;
    height: 58px;
    margin: 0 0 8px 0;
    padding: 6px 1px;
    flex-direction: column;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.shell-rail-button .header-icon {
    width: 17px;
    height: 17px;
    margin-right: 0;
    margin-bottom: 5px;
}

.shell-rail-button .header-button-label {
    font-size: 12px;
}

Button.is-active {
    background-color: rgb(48, 39, 29);
    border-color: rgb(167, 123, 67);
    color: var(--shell-accent);
}

Button.shell-rail-button.is-active .header-button-label {
    color: var(--shell-accent);
}

Button.shell-rail-help {
    margin-top: auto;
    margin-bottom: 0;
}

.sidebar {
    top: 72px;
    bottom: 40px;
    left: 78px;
    width: 300px;
    border-radius: 9px;
    background-color: var(--shell-panel);
    border-color: var(--shell-line);
}

.shell-drawer-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--shell-line);
}

.shell-drawer-title {
    font-size: 17px;
    -unity-font-style: bold;
}

.shell-drawer-head Button {
    min-height: 30px;
    margin: 0;
    padding: 3px 8px;
    font-size: 12px;
}

.sidebar .filter-scroll {
    padding: 12px;
}

.drawer-section {
    flex-shrink: 0;
}

.sidebar .section-title {
    font-size: 12px;
    color: var(--shell-muted);
    margin-top: 16px;
    margin-bottom: 8px;
}

.sidebar .unity-base-field {
    min-height: 32px;
    margin-top: 4px;
    margin-bottom: 6px;
}

.sidebar .unity-base-field__label {
    font-size: 12px;
    color: var(--shell-muted);
}

.sidebar .unity-base-field__input {
    min-height: 30px;
    color: var(--shell-text);
    background-color: rgb(10, 17, 27);
    border-color: var(--shell-line);
}

.sidebar .micro-label, .sidebar .icon-caption {
    font-size: 12px;
}

.sidebar Button.primary .icon-caption {
    color: rgb(30, 22, 13);
}

.sidebar .kind-grid {
    margin-top: 3px;
    margin-bottom: 8px;
}

.sidebar .note {
    color: var(--shell-muted);
    font-size: 12px;
}

.right-column {
    top: 72px;
    bottom: 40px;
    right: 16px;
    width: 360px;
    background-color: var(--shell-panel);
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 9px;
}

.shell-dock-head {
    flex-direction: row;
    padding: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--shell-line);
    flex-shrink: 0;
}

.shell-dock-head Button {
    flex-grow: 1;
    margin: 0 3px;
    min-width: 0;
}

.shell-dock-head #shell-close-dock {
    flex-grow: 0;
    font-size: 12px;
    padding-left: 6px;
    padding-right: 6px;
}

.inspector {
    border-width: 0;
    background-color: var(--shell-panel);
    border-radius: 0;
}

.inspector-body {
    padding: 10px 12px;
    overflow: hidden;
}

.inspector-title {
    font-size: 20px;
    color: var(--shell-text);
    margin-bottom: 4px;
}

.shell-semantic-tag {
    color: var(--shell-text);
    font-size: 12px;
    border-left-width: 3px;
    padding-left: 8px;
}

.tabs {
    padding: 3px 5px;
    flex-shrink: 0;
}

.connection-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 5px 8px;
    border-radius: 4px;
    margin-bottom: 3px;
}

.connection-kind {
    font-size: 11px;
    color: var(--shell-text);
    margin: 0 0 0 8px;
    padding: 0;
}

.tabs Button {
    font-size: 12px;
    min-width: 0;
    min-height: 32px;
    margin: 0 2px;
    padding: 4px 5px;
}

.tabs .icon-caption, .shell-dock-head .icon-caption {
    font-size: 12px;
    margin: 0 0 0 5px;
    padding: 0;
    white-space: nowrap;
}

.inspector .section-title {
    margin: 12px 0 5px 0;
}

.inspector .note {
    margin: 3px 0 6px 0;
}

.inspector .stage-badge {
    padding: 4px 8px;
    margin-bottom: 6px;
}

.inspector Button {
    min-height: 32px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.inspector-actions {
    margin: 3px 0;
}

.inspector-actions Button {
    margin: 2px 4px 2px 0;
    padding-left: 8px;
    padding-right: 8px;
}

.inspector-property {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    min-height: 30px;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 43, 60);
}

.inspector-property-key {
    width: 100px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    padding: 0;
    white-space: normal;
    font-size: 12px;
    color: var(--shell-muted);
}

.inspector-property-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    white-space: normal;
    font-size: 13px;
    color: var(--shell-text);
}

.inspector-provenance {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgb(160, 160, 160);
    opacity: 0.5;
    font-size: 12px;
    margin: 3px 0 6px 0;
    flex-shrink: 1;
}

.inspector Button.source-link {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.inspector-disclosure {
    flex-shrink: 0;
    margin: 0;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 43, 60);
}

.inspector-disclosure > .unity-foldout__toggle {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin: 0;
    padding: 0;
}

.inspector-disclosure .unity-toggle__input {
    order: -1;
    flex-shrink: 0;
    margin-right: 6px;
}

.inspector-disclosure .unity-foldout__text {
    order: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--shell-muted);
    font-size: 12px;
}

.inspector-disclosure .unity-foldout__content {
    margin-left: 0;
}

.connections-list {
    align-items: stretch;
}

.connection {
    align-items: stretch;
}

.connection-target {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 2px 0 4px 0;
}

.connection-relation {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: .35px;
    color: rgb(214, 224, 238);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 88px;
    max-width: 112px;
    margin: 0 10px 0 3px;
}

.inspector .connection-target Button.link {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
    margin: 0;
}

.inspector-disclosure .property-value {
    margin: 4px 0 6px 0;
    font-size: 13px;
    color: var(--shell-text);
}

.property-value, .note, .result-meta {
    color: var(--shell-muted);
    font-size: 12px;
}

.workflow-step {
    min-height: 26px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.graph-workflow-queue .note {
    white-space: normal;
    margin-top: 3px;
    margin-bottom: 5px;
}

.graph-workflow-queue .unity-base-field__label {
    min-width: 92px;
    max-width: 115px;
}

.section-title {
    color: var(--shell-muted);
}

.result-row {
    padding: 7px 8px;
    background-color: var(--shell-panel);
}

.results-panel {
    top: 68px;
    padding: 4px 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.counts {
    font-size: 12px;
    color: var(--shell-muted);
}

.task-queue-panel {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    width: 100%;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--shell-panel);
    padding: 10px;
}

.task-queue-panel Button.queue-action {
    min-height: 34px;
}

.task-queue-panel Button.go {
    background-color: rgb(28, 92, 58);
    border-color: rgb(78, 168, 112);
}

.task-queue-panel Button.go:hover {
    background-color: rgb(36, 118, 72);
}

.task-queue-panel Button.go .icon-caption {
    color: rgb(226, 255, 236);
    font-size: 12px;
}

.queue-head {
    margin-bottom: 8px;
    border-bottom-color: var(--shell-line);
    flex-shrink: 0;
}

.queue-head .section-title {
    font-size: 12px;
}

.queue-rows {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 50px;
}

.queue-message, .queue-sub {
    color: var(--shell-muted);
    font-size: 12px;
}

.queue-spacer {
    flex-grow: 1;
    height: 1px;
    min-width: 8px;
}

.queue-foot {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    flex-shrink: 0;
    margin-top: 2px;
}

.queue-foot Button {
    min-height: 34px;
}

.queue-foot Button.queue-execute {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
}

.queue-card {
    background-color: var(--shell-raised);
}

.tool-belt {
    bottom: 34px;
    align-items: center;
}

/* Status, progress and action bar form one dock: shared chrome, the progress track acts as the divider. */
.tool-dock {
    width: 500px;
    max-width: 100%;
    background-color: var(--shell-panel);
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 9px;
    overflow: hidden;
}

.task-hud {
    width: 100%;
    margin: 0;
    padding: 0;
    align-items: stretch;
}

.task-now {
    width: 100%;
    margin: 0;
    padding: 7px 14px 6px 14px;
    font-size: 12px;
    -unity-font-style: normal;
    color: var(--shell-text);
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    text-shadow: none;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.xp-track {
    width: 100%;
    height: 3px;
    margin: 0;
    align-self: stretch;
    border-width: 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--shell-raised);
}

.xp-fill {
    border-radius: 0;
}

.hotbar-row {
    align-items: center;
    justify-content: center;
    max-width: 100%;
    width: 100%;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.hotbar {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.hotbar-slot {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    margin: 2px;
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 6px;
    background-color: var(--shell-raised);
}

.hotbar-slot:hover {
    background-color: rgb(35, 50, 71);
}

.hotbar-slot.selected {
    border-color: var(--shell-accent);
    background-color: rgb(48, 39, 29);
}

.hotbar-slot.selected:hover {
    background-color: rgb(65, 49, 30);
}

.hotbar-well, .hotbar-slot.selected .hotbar-well {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hotbar-key {
    color: var(--shell-text);
    font-size: 9px;
}

.hotbar-icon {
    width: 24px;
    height: 24px;
}

.hotbar-slot .hotbar-icon {
    position: absolute;
    left: 9px;
    top: 14px;
    width: 22px;
    height: 22px;
}

.hotbar-action {
    background-color: var(--shell-raised);
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 6px;
    width: 34px;
    height: 40px;
    min-width: 34px;
    margin: 2px 5px;
}

.shell-tool-field {
    min-width: 160px;
    max-width: 220px;
    height: 36px;
    margin-left: 8px;
    margin-right: 8px;
}

.shell-tool-field .unity-base-field__input {
    color: var(--shell-text);
    background-color: var(--shell-raised);
}

.footer {
    height: 24px;
    min-height: 24px;
    padding: 3px 16px 3px 80px;
    background-color: var(--shell-background);
}

.footer .status {
    font-size: 12px;
    color: var(--shell-muted);
}

.footer .controls {
    display: none;
}

.loading-overlay {
    top: 56px;
    bottom: 0;
}

.shell-workspace-menu {
    position: absolute;
    top: 62px;
    right: 12px;
    width: 220px;
    padding: 8px;
    background-color: var(--shell-panel);
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 8px;
}

.shell-workspace-menu Button {
    -unity-text-align: middle-left;
    margin: 2px;
}

.shell-resize {
    position: absolute;
    left: -5px;
    top: 52px;
    bottom: 0;
    width: 9px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.shell-resize:hover, .shell-resize:focus {
    border-left-color: var(--shell-accent);
}

.icon-tab {
    align-items: center;
    justify-content: center;
    min-height: 32px;
}

.tab-badge {
    position: absolute;
    right: 3px;
    top: 2px;
    min-width: 16px;
    height: 15px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(30, 22, 13);
    background-color: var(--shell-accent);
    border-radius: 8px;
}

.shell-dock-head Button.icon-tab {
    position: relative;
}

.inspect-steps {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 6px 0 2px 0;
}

.inspector Button.inspect-step {
    border-radius: 5px;
}

.inspector Button.inspect-step.done {
    background-color: rgb(32, 128, 90);
    border-color: rgb(132, 220, 174);
}

.inspector Button.inspect-step.confirm {
    background-color: rgb(12, 64, 44);
    border-width: 2px;
    border-color: rgb(214, 255, 226);
}

.inspector Button.inspect-step.pending:hover {
    border-color: rgb(255, 196, 119);
}

.shell-dock-head Button.icon-tab.queue-flash {
    background-color: rgb(46, 168, 92);
    border-color: rgb(186, 245, 206);
}

.inspector Button.icon-button {
    border-radius: 5px;
}

.inspector Button.icon-button.is-on {
    background-color: rgb(53, 39, 28);
    border-color: rgb(228, 149, 77);
}

.inspector .inspect-actions {
    margin: 4px 0 4px 0;
}

.node-search-popup {
    position: absolute;
    background-color: var(--shell-panel);
    border-width: 1px;
    border-color: var(--shell-line);
    border-radius: 8px;
    padding: 4px;
}

.node-search-status {
    font-size: 11px;
    color: var(--shell-muted);
    padding: 8px;
    white-space: normal;
}

.node-search-item {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    height: 48px;
}

.node-search-item:hover {
    background-color: rgb(35, 50, 71);
}

.node-search-popup .unity-collection-view__item--selected {
    background-color: rgb(60, 46, 29);
    border-left-width: 3px;
    border-left-color: var(--shell-accent);
}

.node-search-icon {
    width: 28px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
}

.node-search-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.node-search-name {
    font-size: 13px;
    color: var(--shell-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-search-kind {
    font-size: 11px;
    color: var(--shell-muted);
}

/* Favorites: gold accent marks starred entities in search, Browse, the drawer, and as 3D markers. */
.favorite-star {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.favorite-mark {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--shell-accent);
    background-color: rgba(18, 12, 4, .92);
    align-items: center;
    justify-content: center;
}

.node-search-item.is-favorite {
    background-color: rgb(54, 41, 20);
    border-left-width: 3px;
    border-left-color: var(--shell-accent);
    padding-left: 6px;
}

.node-search-item.is-favorite:hover {
    background-color: rgb(70, 53, 26);
}

.node-search-item.is-favorite .favorite-star {
    margin-left: 8px;
}

.result-row.is-favorite {
    background-color: rgb(54, 41, 20);
    border-left-width: 3px;
    border-left-color: var(--shell-accent);
    padding-right: 24px;
}

.result-row > .favorite-star {
    position: absolute;
    right: 8px;
    top: 8px;
}

.shell-rail-button .header-button-label {
    white-space: nowrap;
}

/* Selected commits use the runtime highlight. Hover is that same blue, darkened, instead of the theme's light gray. */
#git-revision-list .unity-collection-view__item:hover,
#git-revision-list .unity-collection-view__item:hover:enabled {
    background-color: rgb(40, 74, 114);
}

#git-revision-list .unity-collection-view__item--selected,
#git-revision-list .unity-collection-view__item--selected:hover,
#git-revision-list .unity-collection-view__item--selected:hover:enabled,
#git-revision-list:focus .unity-collection-view__item--selected,
#git-revision-list:focus .unity-collection-view__item--selected:hover {
    background-color: rgb(58, 114, 176);
}

#git-revision-list Button.repo-jump {
    align-self: center;
}

#git-revision-list Button.repo-jump.is-pending {
    opacity: 0.45;
}

/* Shared compact actions: the existing navy, warm accent and muted text palette. */
Button.ux-action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 32px;
    height: 32px;
    margin: 2px;
    padding: 4px 8px;
}

.ux-action .glyph {
    width: 14px;
    height: 14px;
}

.ux-action-caption {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 12px;
    white-space: nowrap;
    color: var(--shell-text);
}

Button.ux-icon-only {
    width: 32px;
    min-width: 32px;
    padding: 6px;
}

Button.workflow-primary {
    background-color: rgb(48, 39, 29);
    border-color: rgb(167, 123, 67);
}

Button.workflow-primary:hover {
    background-color: rgb(65, 49, 30);
    border-color: var(--shell-accent);
}

.workflow-primary .ux-action-caption {
    color: var(--shell-accent);
}

.workflow-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin: 3px 0;
}

.workflow-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--shell-line);
    flex-shrink: 0;
}

.workflow-heading, .workflow-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.workflow-heading {
    margin-bottom: 8px;
}

.workflow-heading .eyebrow {
    flex-grow: 1;
}

.workflow-summary {
    font-size: 12px;
    color: var(--shell-muted);
}

.workflow-section .workflow-step {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    min-height: 34px;
    height: 34px;
    margin: 2px 0;
    padding: 5px 8px;
}

.workflow-section .workflow-step.confirm {
    background-color: rgb(12, 64, 44);
    border-width: 2px;
    border-color: rgb(214, 255, 226);
}

.workflow-step > .glyph {
    width: 13px;
    height: 13px;
}

.workflow-step-title {
    flex-grow: 1;
    font-size: 12px;
    margin-left: 8px;
}

.workflow-step-state {
    font-size: 11px;
    margin-right: 8px;
}

.workflow-section .unity-foldout {
    margin: 5px 0;
}

.workflow-section .unity-toggle__text {
    font-size: 12px;
}

.workflow-section > .workflow-primary {
    align-self: stretch;
}

.workflow-toolbar {
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--shell-line);
    margin-bottom: 8px;
}

.workflow-toolbar-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.graph-workflow-queue .queue-card {
    background-color: var(--shell-raised);
    border-radius: 6px;
    margin-bottom: 8px;
    padding: 7px;
}

.graph-workflow-queue .queue-line {
    min-height: 24px;
}

.graph-workflow-queue .queue-entry-title {
    font-size: 13px;
}

.graph-workflow-queue .queue-chip {
    font-size: 10px;
    border-radius: 4px;
    padding: 3px 6px;
}

.graph-workflow-queue .queue-card .note {
    font-size: 11px;
    margin: 4px 2px;
}

.graph-workflow-queue .queue-card .unity-foldout {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--shell-line);
}

.graph-workflow-queue .unity-foldout__text {
    font-size: 11px;
    color: var(--shell-muted);
}

.graph-workflow-queue .queue-error {
    margin: 6px 2px;
    white-space: normal;
}

.workflow-settings {
    background-color: var(--shell-raised);
    padding: 8px;
    margin-bottom: 10px;
    border-radius: 6px;
}

.graph-workflow-queue .workflow-settings .unity-base-field__label {
    min-width: 68px;
    max-width: 68px;
    font-size: 12px;
}

.graph-workflow-queue .workflow-settings .unity-base-field {
    min-height: 30px;
    margin-bottom: 6px;
}

.workflow-target {
    font-size: 11px;
    color: var(--shell-muted);
    white-space: normal;
}

.workflow-output {
    max-height: 200px;
    font-size: 11px;
}

.workflow-dock {
    width: auto;
    min-width: 220px;
    padding: 0 8px 6px 8px;
}

.workflow-dock .workflow-actions {
    justify-content: center;
    margin: 0;
}

.workflow-hover {
    padding: 12px;
    border-radius: 8px;
    border-color: var(--shell-line);
    background-color: var(--shell-panel);
}

.workflow-hover-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--shell-text);
    white-space: normal;
}

.workflow-hover .note {
    margin: 3px 0 8px 0;
}

.workflow-hover-steps {
    flex-direction: row;
    flex-wrap: wrap;
}

.workflow-hover-step {
    flex-direction: row;
    align-items: center;
    width: 50%;
    min-height: 26px;
}

.workflow-hover-step .glyph {
    width: 12px;
    height: 12px;
    margin-right: 5px;
}

.workflow-hover-caption {
    flex-grow: 1;
    font-size: 11px;
    color: var(--shell-muted);
}

.workflow-hover-state {
    font-size: 14px;
    margin-right: 10px;
}

Button.workflow-mini {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    padding: 3px;
    margin: 1px;
    border-bottom-width: 2px;
    background-color: var(--shell-panel);
}

.workflow-mini .glyph {
    width: 12px;
    height: 12px;
}

.workflow-dock {
    width: 300px;
}

.workflow-dock .hotbar-row {
    padding: 0;
}
