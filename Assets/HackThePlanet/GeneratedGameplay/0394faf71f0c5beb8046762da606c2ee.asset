  evidence:
    title: Dead Signature / Evidence case
    question: Which explanation fits all three signed records?
    clueNodes:
    - n22
    - n9
    - n19
    clues:
    - "The administrator\u2019s death certificate predates the signing event by eleven years."
    - Three vendors each retain a different fragment of the old credential.
    - A quorum receipt combines the fragments without a living administrator.
    answers:
    - id: accident
      title: The records disagree because of an ordinary clerical error.
      feedback: A clerical error does not explain the matching signed authorizations and their order.
      correct: 0
    - id: insider
      title: A lone outsider forged every record after the event.
      feedback: The independent receipt and earlier signatures rule out a single later forgery.
      correct: 0
    - id: rehearsal
      title: The old authority persists through a distributed quorum.
      feedback: "MOTH\u2019s relay holds fragments of that administrator\u2019s authorization."
      correct: 1
  revelation: "MOTH\u2019s relay holds fragments of that administrator\u2019s authorization."
