/* Content Editor window styles. Neutral alpha overlays and opacity keep both editor themes readable. */

/* Window chrome — tabs and action toolbar stack vertically; no shared row */
.ctp-root {
    flex-grow: 1;
    flex-direction: column;
}

.ctp-chrome {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.ctp-tabs {
    flex-shrink: 0;
    height: 34px;
    overflow: hidden;
}

.ctp-tab-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: nowrap;
    padding: 2px 6px;
    height: 100%;
}

.ctp-tab-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 12px;
}

.ctp-tab-strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

.ctp-group-label {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.6;
    margin-right: 6px;
    flex-shrink: 0;
    white-space: nowrap;
}

.ctp-tab {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 2px;
    padding: 2px 8px;
    min-height: 22px;
    white-space: nowrap;
}

.ctp-tab--active {
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(70, 140, 235);
}

.ctp-btn-with-icon {
    flex-direction: row;
    align-items: center;
}

/* Toolbar */
.ctp-toolbar-host {
    flex-shrink: 0;
    width: 100%;
}

.ctp-sep {
    width: 1px;
    margin: 4px 6px;
    background-color: rgba(128, 128, 128, 0.35);
}

.ctp-spacer {
    flex-grow: 1;
}

.ctp-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    flex-shrink: 0;
}

.ctp-icon-btn {
    min-width: 22px;
    height: 20px;
    padding: 0 4px;
    margin-left: 2px;
}

.ctp-suffix {
    margin-left: 4px;
    min-width: 70px;
}

.ctp-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* Validation banner */
.ctp-banner {
    margin: 0 8px;
    flex-shrink: 0;
}

.ctp-banner-list {
    max-height: 160px;
}

.ctp-issue {
    white-space: normal;
    -unity-text-align: middle-left;
}

.ctp-ok {
    margin: 4px 8px;
    opacity: 0.85;
}

/* Entry list sidebar */
.ctp-sidebar {
    min-width: 180px;
}

.ctp-sidebar-head {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px 2px 6px;
}

.ctp-sidebar-title {
    -unity-font-style: bold;
    flex-grow: 1;
}

.ctp-count {
    font-size: 11px;
    opacity: 0.7;
}

.ctp-order-row {
    flex-direction: row;
    padding: 4px;
}

.ctp-item {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 6px;
}

.ctp-item-status {
    width: 16px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.ctp-item-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ctp-item-title {
    font-size: 12px;
    -unity-font-style: bold;
}

.ctp-item-sub {
    font-size: 10px;
    opacity: 0.65;
}

.ctp-dirty {
    color: rgb(240, 170, 40);
    font-size: 10px;
    margin-left: 4px;
}

.ctp-error-glyph {
    color: rgb(220, 70, 70);
    -unity-font-style: bold;
}

/* Form header */
.ctp-header {
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.ctp-header-top {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.ctp-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.ctp-subtitle {
    font-size: 10px;
    opacity: 0.7;
    margin-top: 2px;
}

.ctp-actions {
    margin-left: 8px;
}

.ctp-chip {
    font-size: 10px;
    padding: 1px 6px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: rgba(128, 128, 128, 0.2);
}

.ctp-chip--warn {
    background-color: rgba(240, 170, 40, 0.25);
}

.ctp-chip--error {
    background-color: rgba(220, 70, 70, 0.3);
}

/* Property rows */
.ctp-prop {
    margin-bottom: 6px;
    padding-left: 6px;
    border-left-width: 3px;
    border-left-color: transparent;
}

.ctp-changed {
    border-left-color: rgb(240, 170, 40);
}

.ctp-error {
    border-left-color: rgb(220, 70, 70);
    background-color: rgba(220, 70, 70, 0.08);
}

.ctp-prop-row {
    flex-direction: row;
    align-items: flex-start;
}

.ctp-field-line {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.ctp-field {
    flex-grow: 1;
}

.ctp-field--compact {
    flex-grow: 0;
    width: 280px;
}

.ctp-field > .unity-base-field__label {
    min-width: 160px;
    max-width: 160px;
}

.ctp-label {
    min-width: 160px;
    max-width: 160px;
    padding-top: 3px;
}

.ctp-help {
    font-size: 11px;
    opacity: 0.75;
    white-space: normal;
    margin: 2px 0 0 0;
}

.ctp-help-toggle {
    min-width: 20px;
    width: 20px;
    height: 18px;
    padding: 0;
    margin-left: 4px;
    flex-shrink: 0;
}

.ctp-group {
    margin-bottom: 4px;
}

/* References */
.ctp-ref-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.ctp-ref-pick {
    flex-grow: 1;
}

.ctp-ref-action {
    margin-left: 4px;
}

/* Arrays */
.ctp-array-item {
    margin-left: 12px;
    padding-bottom: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

.ctp-array-head {
    flex-direction: row;
    align-items: center;
}

.ctp-array-title {
    flex-grow: 1;
    opacity: 0.8;
}

/* Status bar */
.ctp-statusbar {
    flex-direction: row;
    align-items: center;
    height: 22px;
    flex-shrink: 0;
    padding: 0 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
}

.ctp-statusbar-text {
    font-size: 11px;
    opacity: 0.8;
}

/* Pickers */
.ctp-choice {
    white-space: normal;
    -unity-text-align: middle-left;
}
