}

.rig-drop-valid {
    background-color: #345f38;
    border-color: #9af58b;
    border-width: 3px;
}

.rig-drop-invalid {
    background-color: #4a2828;
    border-color: #f08080;
    border-width: 3px;
}

.flat-rig {
    background-color: #0a1418;
}

.rig-cell {
    border-width: 1px;
    border-color: #2a4349;
}

.rig-module {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 11px;
    letter-spacing: 1px;
    border-width: 2px;
}

.rig-title-row {
    flex-direction: row;
    align-items: baseline;
    flex-wrap: wrap;
}

.rig-title-row .map-title {
    margin-top: 0;
    margin-right: 14px;
    margin-bottom: 0;
}

.rig-map-heading {
    flex-direction: column;
    align-items: stretch;
}

.rig-map-heading .map-title-block {
    flex-grow: 0;
