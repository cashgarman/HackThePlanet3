}

.rig-map-heading .rig-title-row {
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
}

.rig-map-heading .rig-title-lead {
    flex-direction: row;
    align-items: baseline;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
}

.rig-map-heading .rig-title-lead .map-title {
    margin-right: 14px;
}

.rig-map-heading .rig-budget-actions {
    flex-shrink: 0;
    margin-top: 0;
    margin-left: 16px;
    flex-wrap: nowrap;
}

.rig-map-heading .rig-budgets {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
    flex-grow: 0;
    align-items: flex-end;
}

.rig-budgets {
    flex-shrink: 1;
    min-width: 0;
    flex-grow: 1;
    align-items: flex-end;
    justify-content: center;
    margin-left: 16px;
}

.rig-budgets .micro, .rig-budgets .small {
    -unity-text-align: upper-right;
}

.rig-budget-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-top: 4px;
}

.rig-budget-actions .micro, .rig-budget-actions .small {
    margin-left: 12px;
    margin-top: 0;
    -unity-text-align: middle-right;
}

.rig-budget-actions .secondary-button {
    margin-left: 12px;
    margin-top: 0;
    margin-bottom: 0;
}

.rig-issues {
    flex-shrink: 0;
    flex-direction: column;
    padding: 12px 25px;
    background-color: #241416;
    border-bottom-width: 2px;
    border-bottom-color: #ff786d;
}

.rig-issue {
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 2px;
}

.rig-issue.rig-issue-error {
    color: #ff786d;
    -unity-font-style: bold;
}

.rig-issue.rig-issue-warning {
    color: #f2ba68;
}

.rig-details {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 24px 22px 10px 22px;
}

.rig-inventory {
    height: 50%;
    flex-shrink: 0;
    min-height: 0;
    padding: 14px 16px 12px 16px;
    border-top-width: 1px;
    border-top-color: #26383e;
    background-color: #101c23;
}

.rig-inventory.rig-drop-zone {
    border-top-width: 2px;
    border-top-color: #9af58b;
    background-color: #14281f;
}

.rig-category-tabs {
    flex-direction: row;
    flex-wrap: nowrap;
    margin-bottom: 8px;
    min-width: 0;
}

.rig-shop-category-tabs {
    margin-top: 8px;
    margin-bottom: 4px;
}

.rig-category-tab {
    width: 30px;
    height: 30px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 2px;
    margin-bottom: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #32444a;
    background-color: #132027;
}

.rig-category-tab:hover {
    border-color: #88abb3;
}

.rig-category-tab.active {
    border-color: #c5f56b;
    background-color: #1c2d24;
}

.rig-inventory-list {
    flex-grow: 1;
    min-height: 0;
}

.rig-inventory-row {
    white-space: normal;
    margin-top: 6px;
}

.rig-inventory-empty {
    min-height: 44px;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: #26383e;
    background-color: #101c23;
}

.rig-part-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.rig-inventory-row .rig-part-content {
    justify-content: flex-start;
}

.rig-part-title {
    margin-left: 7px;
    white-space: normal;
    -unity-text-align: middle-left;
    flex-shrink: 1;
}

.rig-shop-head {
    flex-direction: row;
    align-items: center;
}

.rig-shop .eyebrow, .rig-inventory > .eyebrow {
    font-size: 12px;
}

.rig-shop .small, .rig-inventory .small, .rig-details .small {
    font-size: 15px;
}

.rig-shop .micro, .rig-inventory .micro, .rig-details .micro {
    font-size: 12px;
}

.rig-layout .rig-shop .rig-shop-card .small, .rig-layout .rig-details .small {
    font-size: 16px;
}

.rig-layout .rig-shop .rig-shop-card .micro, .rig-layout .rig-budgets .micro {
    font-size: 12px;
}

.rig-layout .rig-inventory .eyebrow {
    font-size: 15px;
}

.rig-shop .rig-part-title {
    font-size: 16px;
}

.rig-details .body-copy {
    font-size: 15px;
    line-height: 1.35;
}

.rig-category-tab {
    width: 30px;
    height: 30px;
}

.rig-inventory-row {
    min-height: 44px;
}

.rig-stat {
    margin-left: 16px;
    margin-top: 5px;
}

.rig-stat-icon {
    margin-right: 7px;
}

.rig-layout .rig-shop .eyebrow, .rig-layout .rig-inventory .eyebrow {
    font-size: 30px;
}

.rig-layout .rig-shop .small, .rig-layout .rig-inventory .small, .rig-layout .rig-details .small {
    font-size: 32px;
}

.rig-layout .rig-shop .micro, .rig-layout .rig-inventory .micro, .rig-layout .rig-details .micro, .rig-layout .rig-budgets .micro {
    font-size: 24px;
}

.rig-layout .rig-shop .rig-part-title, .rig-layout .rig-part-title {
    font-size: 32px;
}

.rig-layout .rig-details .body-copy {
    font-size: 30px;
    line-height: 1.35;
}

.rig-layout .rig-details .eyebrow {
    font-size: 30px;
}

.rig-layout .rig-details .mission-title {
    font-size: 40px;
}

.rig-layout .rig-module {
    font-size: 22px;
}

.rig-layout .rig-module .rig-part-title {
    font-size: 24px;
}

.rig-layout .rig-shop .secondary-button, .rig-layout .rig-details .secondary-button, .rig-layout .rig-details .danger-button {
    font-size: 26px;
    min-height: 72px;
}

.rig-layout .rig-category-tab {
    width: 30px;
    height: 30px;
}

.rig-layout .rig-inventory-row {
    min-height: 72px;
}

.rig-budgets > .rig-stat-line {
    flex-wrap: nowrap;
    flex-shrink: 1;
    min-width: 0;
}

.rig-budgets > .rig-stat-line > .rig-stat {
    flex-shrink: 0;
    margin-left: 8px;
    margin-top: 0;
}

.rig-budgets > .rig-stat-line > .rig-stat > Label {
    white-space: nowrap;
}

.rig-stat-line {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    max-width: none;
}

.rig-stat {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    margin-top: 2px;
}

.rig-stat-icon {
    margin-right: 4px;
}

.rig-layout .rig-budgets .small, .rig-layout .rig-budgets .micro {
    font-size: 12px;
}
