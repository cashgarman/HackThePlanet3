{
  "id": "delivery",
  "title": "Delivery rewards",
  "description": "",
  "archiveCredits": 100,
  "archiveXp": 15,
  "archiveXpCap": 45,
  "quietCredits": 100,
  "quietXp": 20,
  "rules": [
    {
      "when": {
        "type": "AlwaysCondition"
      },
      "credits": {
        "type": "InputNumber",
        "input": "ContractCredits",
        "key": "",
